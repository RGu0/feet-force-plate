{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physical-pressure-session/1.0",
  "title": "Physical pressure session",
  "description": "Hardware-independent physical force field. Only hardware-accepted sessions are emitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "coordinate_frame",
    "coordinate_unit",
    "force_unit",
    "time_unit",
    "points",
    "frames"
  ],
  "properties": {
    "schema_version": {"const": "physical-pressure-session/1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "coordinate_frame": {"const": "BOARD_TOP_LEFT_X_RIGHT_Y_DOWN"},
    "coordinate_unit": {"const": "mm"},
    "force_unit": {"const": "N"},
    "time_unit": {"const": "s"},
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["point_id", "board_x_mm", "board_y_mm"],
        "properties": {
          "point_id": {"type": "string", "minLength": 1},
          "board_x_mm": {"type": "number"},
          "board_y_mm": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp_s", "normal_force_n"],
        "properties": {
          "timestamp_s": {"type": "number", "minimum": 0},
          "normal_force_n": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "number", "minimum": 0}
          }
        },
        "additionalProperties": false
      }
    }
  }
}
