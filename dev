#!/usr/bin/env bash
# Governed FeetForcePlate command entrypoint for macOS and Linux.
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
uv_bin="${UV_BIN:-}"

if [ -z "$uv_bin" ]; then
    uv_bin="$(command -v uv 2>/dev/null || true)"
fi
if [ -z "$uv_bin" ] || [ ! -x "$uv_bin" ]; then
    echo "uv is required; install it as a device bootstrap prerequisite." >&2
    exit 127
fi

# An explicit path bypasses uv centralized project environments. Clear inherited
# legacy settings; uv then uses its cache-backed environment when supported and
# an isolated Worktree .venv when the preview feature is unavailable.
unset UV_PROJECT_ENVIRONMENT
if [[ ",${UV_PREVIEW_FEATURES:-}," != *,centralized-project-envs,* ]]; then
    export UV_PREVIEW_FEATURES="${UV_PREVIEW_FEATURES:+${UV_PREVIEW_FEATURES},}centralized-project-envs"
fi
export PYTHONPATH="$project_root${PYTHONPATH:+:$PYTHONPATH}"
cd "$project_root"

sync() {
    "$uv_bin" sync --locked --extra dev "$@"
}

action="${1:-}"
shift || true
case "$action" in
    setup)
        [ "$#" -eq 0 ] || { echo "setup accepts no arguments" >&2; exit 2; }
        sync
        ;;
    test)
        [ "$#" -eq 0 ] || { echo "test accepts no arguments" >&2; exit 2; }
        sync
        QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}" "$uv_bin" run --locked --extra dev python -m pytest
        ;;
    lint)
        [ "$#" -eq 0 ] || { echo "lint accepts no arguments" >&2; exit 2; }
        sync
        "$uv_bin" run --locked --extra dev ruff check .
        "$uv_bin" run --locked --extra dev mypy shared/contracts cloud/observability
        ;;
    build)
        [ "$#" -eq 0 ] || { echo "build accepts no arguments" >&2; exit 2; }
        sync --extra build
        "$uv_bin" run --locked --extra dev --extra build python -m compileall -q client cloud shared
        foundation_release_dir="$(mktemp -d "${TMPDIR:-/tmp}/techflex-cloud-foundation.XXXXXX")"
        trap 'rm -rf "$foundation_release_dir"' EXIT
        "$uv_bin" build packages/techflex-cloud-foundation --out-dir "$foundation_release_dir"
        "$uv_bin" run --locked --extra dev python scripts/record_foundation_release_baseline.py \
            --project-root "$project_root" \
            --dist-dir "$foundation_release_dir" \
            --baseline-strategy legacy-httpx-client/1 \
            --output "$foundation_release_dir/release-evidence.json"
        ;;
    run)
        [ "$#" -gt 0 ] || { echo "run requires a command" >&2; exit 2; }
        sync
        "$uv_bin" run --locked --extra dev "$@"
        ;;
    *)
        echo "usage: ./dev {setup|test|lint|build|run <command...>}" >&2
        exit 2
        ;;
esac
