{
  "schema_version": 1,
  "targets": {
    "windows-x86_64": {
      "installer": "signed-installer-required",
      "driver_check": "CH340-ready-before-device-use",
      "signing": "CI-secret-reference-only"
    },
    "macos-universal2-pilot": {
      "bundle": "signed-pilot-app",
      "notarization": "required-for-external-pilot",
      "signing": "CI-keychain-reference-only"
    }
  },
  "persistent_data_policy": "preserve-on-uninstall-and-rollback",
  "upgrade_policy": "idle-only-signed-digest-verified-with-database-rollback",
  "support_recipient": {
    "build_input": "optional-public-x25519-resource",
    "packaged_resource": "support-recipient.json",
    "missing_resource_behavior": "diagnostic-export-disabled-fail-closed"
  },
  "embedded_credentials": false
}
